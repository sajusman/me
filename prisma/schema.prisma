// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An anonymous visitor identity. Created automatically on first visit; the
/// username is auto-generated (e.g. "Swift-Falcon-4821").
model Profile {
  id         String   @id @default(uuid())
  // Links this profile to the signed session cookie set by proxy.ts.
  sessionId  String   @unique
  username   String   @unique
  avatarSeed String   @default(uuid())
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@map("profiles")
}
