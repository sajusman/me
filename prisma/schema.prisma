// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An anonymous visitor identity. Created automatically on first visit; the
/// username is auto-generated (e.g. "Swift-Falcon-4821").
model Profile {
  id         String    @id @default(uuid())
  // Links this profile to the signed session cookie set by proxy.ts.
  sessionId  String    @unique
  username   String    @unique
  avatarSeed String    @default(uuid())
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  comments   Comment[]

  @@map("profiles")
}

/// Tracks referral sources (the `?ref=` query param, e.g. "cv", "linkedin",
/// "github") per anonymous session. One row per (sessionId, ref) pair: repeated
/// opens from the same session bump `openCount` and `lastOpenedAt` rather than
/// inserting new rows. The `@@unique([sessionId, ref])` is what enforces this
/// and makes the upsert race-safe (a losing insert hits the constraint and is
/// retried as an update — see server/referrals/referral.ts).
model Referral {
  id            String   @id @default(uuid())
  // Links this open to the signed session cookie set by proxy.ts.
  sessionId     String
  // The referral source, e.g. "cv" / "linkedin" / "github".
  ref           String
  // The path where the ref was first seen (e.g. "/").
  path          String
  // How many times this session has opened a page carrying this ref.
  openCount     Int      @default(1)
  firstOpenedAt DateTime @default(now())
  lastOpenedAt  DateTime @default(now())

  @@unique([sessionId, ref])
  @@index([ref, lastOpenedAt])
  @@map("referrals")
}

/// A comment on a blog post. Top-level comments have `parentId = null`; replies
/// point at their parent. Depth is capped at one level (a reply cannot itself be
/// replied to) — enforced in application code (api/comments/reply.ts).
model Comment {
  id        String   @id @default(uuid())
  // Blog post slug (posts live as MDX files, not in the DB).
  postSlug  String
  body      String
  authorId  String
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Null for a top-level comment; set for a reply.
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())

  @@index([postSlug, createdAt])
  @@index([parentId])
  @@index([authorId])
  @@map("comments")
}

/// An append-only history of every comment body a user has ever submitted.
/// Written when a comment or reply is created; never updated or deleted by the
/// app. Deleting a Comment leaves its log rows intact — the references here are
/// plain scalars (no cascading foreign keys), so the audit trail outlives both
/// the comment and, if it were removed, the author's profile.
model CommentLog {
  id       String  @id @default(uuid())
  // The comment this log entry captures. Kept as a plain scalar (not an FK
  // relation) so the row survives after the comment is deleted.
  commentId String?
  postSlug  String
  authorId  String
  body      String
  // What produced this entry (e.g. "create"). Room to grow to "edit" later.
  action    String   @default("create")
  createdAt DateTime @default(now())

  @@index([commentId])
  @@index([authorId])
  @@index([postSlug, createdAt])
  @@map("comment_logs")
}
